      <column caption='Approved Exposure' datatype='real' name='[Calculation_0014323057999988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [PD] &lt;= [Parameters].[Parameter 0015009933533208]&#10;&#10;THEN [EAD]&#10;&#10;END' />
      </column>
      <column caption='Rejected Exposure' datatype='real' name='[Calculation_0014323058098293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [PD] &gt; [Parameters].[Parameter 0015009933533208]&#10;&#10;THEN [EAD]&#10;&#10;END' />
      </column>
      <column caption='Approved Expected Loss' datatype='real' name='[Calculation_0014323058192502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [PD] &lt;= [Parameters].[Parameter 0015009933533208]&#10;&#10;THEN [EXPECTED_LOSS]&#10;&#10;END' />
      </column>
      <column caption='Predicted Default' datatype='string' name='[Calculation_0014391815368753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PD] &gt;= 0.50 THEN &quot;Default&quot;&#10;ELSE &quot;Non-Default&quot;&#10;END' />
      </column>
      <column caption='Actual Default' datatype='string' name='[Calculation_0014391816028210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TARGET] = 1 THEN &quot;Default&quot;&#10;ELSE &quot;Non-Default&quot;&#10;END' />
      </column>
      <column caption='Underwriting Decision' datatype='string' name='[Calculation_0015009933819929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PROBABILITY_OF_DEFAULT] &lt;= [Parameters].[Parameter 0015009933533208]&#10;THEN &quot;Approved&quot;&#10;ELSE &quot;Rejected&quot;&#10;END' />
      </column>
      <column caption='Approval Flag' datatype='integer' name='[Calculation_0015009933955098]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [PROBABILITY_OF_DEFAULT] &lt;= [Parameters].[Parameter 0015009933533208]&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Approval Rate' datatype='real' name='[Calculation_0015009934028827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0015009933955098]) / COUNT([SK_ID_CURR])' />
      </column>
      <column caption='Average PD' datatype='real' name='[Calculation_0015009934327836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([PROBABILITY_OF_DEFAULT])' />
      </column>
      <column caption='Total Exposure' datatype='real' name='[Calculation_0015009934442525]' role='measure' type='quantitative'>
